// Prisma schema capturing ledger-based inventory for PCOs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  WAREHOUSE
  TECH
}

enum UnitBaseType {
  MASS
  VOLUME
  COUNT
}

enum ProductCategory {
  CHEMICAL
  EQUIPMENT
  PPE
  OTHER
}

enum ProductBehavior {
  CONSUMABLE
  NONCONSUMABLE
  REGULATED_CUSTOMER_BOUND
}

enum ProductType {
  DUST
  GRANULE
  CONCENTRATE
  AEROSOL
  ANT_BAIT
  ROACH_BAIT
  RODENT_BAIT
  SANITATION
  OTHER
}

enum ProductTrackingMode {
  EQUIPMENT
  BULK
}

enum TransferDirection {
  ISSUE
  RETURN
}

enum TransferRequestStatus {
  OPEN
  SUBMITTED
  FINALIZED
  ACK_PENDING
  ACKNOWLEDGED
  REJECTED
  CANCELED
  DISPUTED
}

enum TransactionType {
  initial_load
  receiving_posted
  checkout_requested
  checkout_finalized
  adjustment
  audit_count
  checkin_return
  transfer
}

enum AuditStatus {
  DRAFT
  FINALIZED
}

enum AuditUnitBasis {
  CHECKOUT
  TRACKING
}

enum ReceiptStatus {
  draft
  posted
}

enum CheckoutStatus {
  requested
  approved
  ready
  issued
}

model User {
  id                      String                 @id @default(cuid())
  email                   String                 @unique
  passwordHash            String
  name                    String
  role                    Role
  location                String?
  technicianId            String?
  technician              Technician?            @relation(fields: [technicianId], references: [id])
  active                  Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  transactions            InventoryTransaction[]
  incoming                IncomingReceipt[]      @relation("UserIncoming")
  checkout                CheckoutRequest[]      @relation("UserCheckout")
  notifications           Notification[]
  createdTransferRequests TransferRequest[]      @relation("TransferRequestCreatedBy")
  finalizedTransfers      TransferRequest[]      @relation("TransferRequestFinalizedBy")
  acknowledgedTransfers   TransferRequest[]      @relation("TransferRequestAcknowledgedBy")
  auditSessions           AuditSession[]         @relation("AuditSessionCreatedBy")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Product {
  id                String              @id @default(cuid())
  name              String              @unique
  epaRegNo          String?
  description       String?
  category          ProductCategory     @default(CHEMICAL)
  behavior          ProductBehavior     @default(CONSUMABLE)
  trackingMode      ProductTrackingMode @default(BULK)
  productType       ProductType?
  baseType          UnitBaseType
  trackingUnitLabel String
  checkoutUnitLabel String
  orderingUnitLabel String
  trackingToBase    Int // multiplier to base unit (oz/fl_oz/each)
  checkoutToBase    Int
  orderingToBase    Int
  reorderLevelBase  Int?
  quantityInReorder Int? // mirrors Excel quantity in reorder
  leadTimeDays      Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  isStocked         Boolean             @default(true)
  isDiscontinued    Boolean             @default(false)

  packs                ProductPack[]
  codes                ProductCode[]
  transactions         InventoryTransaction[]
  balances             InventoryBalance[]
  reorderPolicy        ReorderPolicy?
  incomingLines        IncomingLine[]
  checkoutLines        CheckoutLine[]
  transferRequestLines TransferRequestLine[]
  auditLines           AuditLine[]
}

model ProductPack {
  id              String        @id @default(cuid())
  product         Product       @relation(fields: [productId], references: [id])
  productId       String
  name            String
  quantityPerPack Int // number of ordering units
  orderingToBase  Int // base units per ordering unit (e.g., 18 oz)
  createdAt       DateTime      @default(now())
  codes           ProductCode[]
}

model ProductCode {
  id        String       @id @default(cuid())
  product   Product      @relation(fields: [productId], references: [id])
  productId String
  pack      ProductPack? @relation(fields: [packId], references: [id])
  packId    String?
  codeType  String // qr, barcode, sku
  payload   String       @unique
  createdAt DateTime     @default(now())
}

model InventoryBalance {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id])
  productId  String
  scope      String   @default("WAREHOUSE")
  onHandBase Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([productId, scope])
}

model InventoryTransaction {
  id                     String          @id @default(cuid())
  product                Product         @relation(fields: [productId], references: [id])
  productId              String
  type                   TransactionType
  scope                  String          @default("WAREHOUSE")
  quantityBase           Int
  beforeBase             Int
  afterBase              Int
  actor                  User?           @relation(fields: [actorId], references: [id])
  actorId                String?
  actorRole              Role?
  device                 String?
  reason                 String?
  idempotencyKey         String
  transferGroupId        String?
  transferIdempotencyKey String?

  sourceReceiptLine IncomingLine? @relation("IncomingLineTransactions", fields: [incomingLineId], references: [id])
  incomingLineId    String?

  sourceCheckoutLine CheckoutLine? @relation("CheckoutLineTransactions", fields: [checkoutLineId], references: [id])
  checkoutLineId     String?

  createdAt DateTime @default(now())
  comment   String?

  @@unique([idempotencyKey])
  @@index([transferIdempotencyKey])
  @@index([type, createdAt])
  @@index([productId])
  @@index([scope])
}

model AuditSession {
  id            String      @id @default(cuid())
  locationScope String      @default("WAREHOUSE")
  status        AuditStatus @default(DRAFT)
  notes         String?
  createdBy     User        @relation("AuditSessionCreatedBy", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime    @default(now())
  finalizedAt   DateTime?

  lines AuditLine[]

  @@index([status])
  @@index([locationScope])
}

model AuditLine {
  id             String         @id @default(cuid())
  auditSession   AuditSession   @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  auditSessionId String
  product        Product        @relation(fields: [productId], references: [id])
  productId      String
  countedQty     Decimal
  unitBasis      AuditUnitBasis
  desiredBase    Decimal
  deltaBase      Decimal
  createdAt      DateTime       @default(now())

  @@unique([auditSessionId, productId])
  @@index([productId])
}

model IncomingReceipt {
  id          String         @id @default(cuid())
  receiptDate DateTime
  supplier    String?
  status      ReceiptStatus  @default(draft)
  createdBy   User           @relation("UserIncoming", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime       @default(now())
  postedAt    DateTime?
  lines       IncomingLine[]
}

model IncomingLine {
  id                 String          @id @default(cuid())
  receipt            IncomingReceipt @relation(fields: [receiptId], references: [id])
  receiptId          String
  product            Product         @relation(fields: [productId], references: [id])
  productId          String
  qtyOrdered         Int
  qtyReceived        Int
  backorderedQty     Int
  receivingUnitLabel String // user selected label (e.g., case, bottle)
  createdAt          DateTime        @default(now())

  transactions InventoryTransaction[] @relation("IncomingLineTransactions")
}

model CheckoutRequest {
  id           String         @id @default(cuid())
  requestDate  DateTime
  status       CheckoutStatus @default(requested)
  technician   User           @relation("UserCheckout", fields: [technicianId], references: [id])
  technicianId String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lines        CheckoutLine[]
  readyById    String?
}

model CheckoutLine {
  id                String          @id @default(cuid())
  request           CheckoutRequest @relation(fields: [requestId], references: [id])
  requestId         String
  product           Product         @relation(fields: [productId], references: [id])
  productId         String
  qtyRequested      Int
  qtyIssued         Int?
  checkoutUnitLabel String
  totalBaseQuantity Int? // derived
  createdAt         DateTime        @default(now())

  transactions InventoryTransaction[] @relation("CheckoutLineTransactions")
}

model ReasonCode {
  id          String  @id @default(cuid())
  name        String
  description String?
  active      Boolean @default(true)
}

model ReorderPolicy {
  id                 String   @id @default(cuid())
  product            Product  @relation(fields: [productId], references: [id])
  productId          String   @unique
  reorderLevelBase   Int
  targetDaysOfSupply Int?
  supplier           String?
  leadTimeDays       Int?
  updatedAt          DateTime @updatedAt
}

model TransferRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUserId String
  createdByUser   User   @relation("TransferRequestCreatedBy", fields: [createdByUserId], references: [id])

  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id])

  direction   TransferDirection
  fromScope   String
  toScope     String
  status      TransferRequestStatus @default(SUBMITTED)
  reason      String?
  submittedAt DateTime              @default(now())

  finalizedAt       DateTime?
  finalizedByUserId String?
  finalizedByUser   User?     @relation("TransferRequestFinalizedBy", fields: [finalizedByUserId], references: [id])

  acknowledgedAt       DateTime?
  acknowledgedByUserId String?
  acknowledgedByUser   User?     @relation("TransferRequestAcknowledgedBy", fields: [acknowledgedByUserId], references: [id])

  disputeNote String?

  requestIdempotencyKey String? @unique

  lines TransferRequestLine[]
}

model TransferRequestLine {
  id                String          @id @default(cuid())
  transferRequestId String
  transferRequest   TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Float
  unitLabel         String
}

model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  message   String
  type      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Technician {
  id               String            @id @default(cuid())
  name             String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  transferRequests TransferRequest[]
}
